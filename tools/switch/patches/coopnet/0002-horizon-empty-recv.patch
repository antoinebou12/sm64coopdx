+    // code below interprets as EOF and disconnects a healthy signaling socket.
+    // macOS already needs the same guard. Wait for a later update with data (or
+    // a socket error) instead of manufacturing a false remote disconnect.
     if (remaining <= 0) { return; }
 #endif
 

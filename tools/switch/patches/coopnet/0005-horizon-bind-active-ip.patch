--- a/common/peer.cpp
+++ b/common/peer.cpp
@@ -3,6 +3,9 @@
 #include <mutex>
 #include <cstdio>
 #include <cstring>
+#ifdef __SWITCH__
+#include <switch.h>
+#endif
 #include <unistd.h>
 #include "libcoopnet.h"
 #include "peer.hpp"
@@ -103,6 +106,58 @@ Peer::Peer(Client* aClient, uint64_t aId, uint32_t aPriority) {
     config.cb_recv = sOnRecv;
     config.user_ptr = this;
     config.concurrency_mode = JUICE_CONCURRENCY_MODE_POLL;
+
+#ifdef __SWITCH__
+    /*
+     * NIFM used to be initialized during global platform startup. The first
+     * full-ROM builds after that change started faulting in thread5_game_loop,
+     * before CoopNet is used. Keep the service completely out of game bootstrap
+     * and initialize it once, lazily, when the first ICE peer is created.
+     *
+     * The session intentionally remains alive until process exit. Multiple ICE
+     * peers share it, so tearing NIFM down from an individual Peer destructor
+     * would invalidate other active peers.
+     */
+    static std::once_flag horizonNifmOnce;
+    static Result horizonNifmInitRc = 1;
+    std::call_once(horizonNifmOnce, []() {
+        horizonNifmInitRc = nifmInitialize(NifmServiceType_User);
+    });
+    horizon_diag("ice.nifm_init", mId, (uint64_t)(uint32_t)horizonNifmInitRc);
+
+    /*
+     * Do not derive the ICE bind address from the signaling socket. On Horizon
+     * getsockname() can still report INADDR_ANY for a valid connected socket,
+     * which makes libjuice fall back to wildcard binding and drops the local
+     * host candidate. NIFM owns the active interface and returns the current
+     * IPv4 address in struct-in_addr byte order, so use it as the authoritative
+     * source. Keep getsockname() only as a fallback for unusual NIFM failures.
+     */
+    char horizonBindAddress[INET_ADDRSTRLEN] = { 0 };
+    u32 horizonIpv4 = 0;
+    Result nifmRc = horizonNifmInitRc;
+    if (R_SUCCEEDED(horizonNifmInitRc)) {
+        nifmRc = nifmGetCurrentIpAddress(&horizonIpv4);
+    }
+    if (R_SUCCEEDED(nifmRc) && horizonIpv4 != 0 &&
+        inet_ntop(AF_INET, &horizonIpv4, horizonBindAddress, sizeof(horizonBindAddress))) {
+        config.bind_address = horizonBindAddress;
+        LOG_INFO("Switch ICE bind address (NIFM): %s", horizonBindAddress);
+        horizon_diag("ice.bind_address", mId, (uint64_t)ntohl(horizonIpv4), horizonBindAddress);
+    } else if (aClient && aClient->mConnection && aClient->mConnection->mSocket > 0) {
+        struct sockaddr_in local = { 0 };
+        socklen_t localLen = sizeof(local);
+        if (getsockname(aClient->mConnection->mSocket, (struct sockaddr*)&local, &localLen) == 0 &&
+            local.sin_family == AF_INET && local.sin_addr.s_addr != htonl(INADDR_ANY) &&
+            inet_ntop(AF_INET, &local.sin_addr, horizonBindAddress, sizeof(horizonBindAddress))) {
+            config.bind_address = horizonBindAddress;
+            LOG_INFO("Switch ICE bind address (socket fallback): %s", horizonBindAddress);
+            horizon_diag("ice.bind_address_fallback", mId,
+                         (uint64_t)ntohl(local.sin_addr.s_addr), horizonBindAddress);
+        } else {
+            horizon_diag("ice.bind_address_failed", mId, (uint64_t)(uint32_t)nifmRc);
+        }
+    } else {
+        horizon_diag("ice.bind_address_failed", mId, (uint64_t)(uint32_t)nifmRc);
+    }
+#endif
 
     mConnected = false;
     mAgent = juice_create(&config);

@@ -90,7 +96,23 @@ static std::string readFileData(const std::string &filepath) {
 }
 
 std::size_t hashFile(const std::string &filepath = getExecutablePath()) {
+#ifdef __SWITCH__
+    horizon_diag("identity.hash_begin", 0, 0, filepath.c_str());
+    const CoopNetSwitchIdentityResult result = coopnet_switch_identity(filepath.c_str());
+    if (result.cached) {
+        horizon_diag("identity.hash_cached", result.bytes, result.hash, filepath.c_str());
+    } else if (result.error == COOPNET_SWITCH_IDENTITY_OK) {
+        horizon_diag("identity.hash_complete", result.bytes, result.hash, filepath.c_str());
+    } else {
+        horizon_diag("identity.hash_failed",
+                     static_cast<uint64_t>(result.error),
+                     result.bytes,
+                     filepath.c_str());
+    }
+    return static_cast<std::size_t>(result.hash);
+#else
     const std::string data = readFileData(filepath);
     if (data == "") { return 0; }
     return std::hash<std::string>{}(data);
+#endif
 }

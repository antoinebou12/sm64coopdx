--- a/src/udp.c
+++ b/src/udp.c
@@ -17,6 +17,10 @@
 #include <string.h>
 #include <time.h>
 
+#ifdef __SWITCH__
+#include <switch.h>
+#endif
+
 static struct addrinfo *find_family(struct addrinfo *ai_list, int family) {
 	struct addrinfo *ai = ai_list;
 	while (ai && ai->ai_family != family)
@@ -441,6 +445,35 @@ int udp_get_addrs(socket_t sock, addr_record_t *records, size_t count) {
 
 	uint16_t port = addr_get_port((struct sockaddr *)&bound.addr);
 
+#ifdef __SWITCH__
+	/*
+	 * Horizon does not expose a normal desktop interface-enumeration stack.
+	 * libjuice's NO_IFADDRS fallback uses SIOCGIFCONF, which is not a reliable
+	 * way to discover the active Wi-Fi address on Switch. Ask NIFM directly for
+	 * the current IPv4 address and use the UDP socket's actual bound port.
+	 *
+	 * STUN/TURN gathering still runs normally after this host candidate is
+	 * returned, so NAT traversal is preserved; this only replaces local address
+	 * discovery.
+	 *
+	 * NIFM is initialized lazily to avoid eager network service startup during
+	 * platform init which regresses Switch boot.
+	 */
+	static bool sNifmInitializedLibjuice = false;
+	if (!sNifmInitializedLibjuice) {
+		nifmInitialize(NifmServiceType_User);
+		sNifmInitializedLibjuice = true;
+	}
+	if (bound.addr.ss_family == AF_INET) {
+		u32 ipv4 = 0;
+		Result nifm_rc = nifmGetCurrentIpAddress(&ipv4);
+		if (R_SUCCEEDED(nifm_rc) && ipv4 != 0) {
+			if (count > 0) {
+				memset(&records[0], 0, sizeof(records[0]));
+				struct sockaddr_in *sin = (struct sockaddr_in *)&records[0].addr;
+				sin->sin_family = AF_INET;
+				sin->sin_port = htons(port);
+				memcpy(&sin->sin_addr.s_addr, &ipv4, sizeof(ipv4));
+				records[0].len = sizeof(*sin);
+			}
+			return 1;
+		}
+		JLOG_WARN("nifmGetCurrentIpAddress unavailable, rc=0x%08X", (unsigned int)nifm_rc);
+	}
+#endif
+
 	// RFC 8445 5.1.1.1. Host Candidates:
 	// Addresses from a loopback interface MUST NOT be included in the candidate addresses.
 	// [...]

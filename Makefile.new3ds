# SM64CoopDX New 3DS port foundation.
#
# This target is deliberately isolated from the desktop and Switch build graphs.
# The default target builds the native dual-screen shell. `port-smoke` also
# cross-compiles the CoopDX-facing renderer/controller/window/audio/thread/platform
# layers so platform work cannot silently rot before the full game target is linked.

.SUFFIXES:

ifeq ($(strip $(DEVKITARM)),)
$(error "Please set DEVKITARM in your environment (for example /opt/devkitpro/devkitARM)")
endif

TOPDIR ?= $(CURDIR)
include $(DEVKITARM)/3ds_rules

TARGET_NAME := sm64coopdx-new3ds
BUILD := $(TOPDIR)/build/new3ds-shell
SOURCES := $(TOPDIR)/src/pc/platform/new3ds
INCLUDES := $(TOPDIR)/src/pc/platform/new3ds
PICASSO ?= picasso

# Keep the standalone shell intentionally small. Full-game platform source files
# live in the same directory but are compiled by port-smoke / the future full target.
SHELL_CFILES := new3ds_main.c new3ds_runtime.c new3ds_ui.c

ARCH := -march=armv6k -mtune=mpcore -mfloat-abi=hard -mtp=soft
CFLAGS := -g -O2 -Wall -Wextra -Werror -mword-relocations \
          -ffunction-sections -fdata-sections $(ARCH)
CFLAGS += $(INCLUDE) -D__3DS__ -DNEW_3DS_PORT=1 -std=gnu11
ASFLAGS := -g $(ARCH)
LDFLAGS := -specs=3dsx.specs -g $(ARCH) -Wl,-Map,$(TARGET_NAME).map -Wl,--gc-sections

LIBS := -lcitro2d -lcitro3d -lctru -lm
LIBDIRS := $(CTRULIB)

SMOKE_INCLUDES := \
    -I$(TOPDIR) \
    -I$(TOPDIR)/include \
    -I$(TOPDIR)/src \
    -I$(TOPDIR)/src/pc \
    -I$(TOPDIR)/src/pc/gfx \
    -I$(TOPDIR)/src/pc/audio \
    -I$(TOPDIR)/src/pc/controller \
    -I$(TOPDIR)/src/pc/platform/new3ds \
    -I$(CTRULIB)/include
# Match the normal non-N64 port preprocessor contract. The upstream build sets
# these automatically when TARGET_N64=0; smoke files are compiled directly and
# therefore need the same definitions explicitly.
SMOKE_CFLAGS := -g -O2 -Wall -Wextra -Werror -mword-relocations \
                -ffunction-sections -fdata-sections $(ARCH) \
                -D__3DS__ -DNEW_3DS_PORT=1 -DNON_MATCHING=1 -DAVOID_UB=1 \
                -std=gnu11 $(SMOKE_INCLUDES)

export APP_TITLE := SM64CoopDX New 3DS
export APP_DESCRIPTION := Native New 3DS port foundation
export APP_AUTHOR := SM64CoopDX contributors

ifneq ($(CURDIR),$(BUILD))

export OUTPUT := $(BUILD)/$(TARGET_NAME)
export TOPDIR
export VPATH := $(SOURCES)
export DEPSDIR := $(BUILD)

CFILES := $(SHELL_CFILES)
SFILES :=

export LD := $(CC)
export OFILES := $(CFILES:.c=.o) $(SFILES:.s=.o)
export INCLUDE := $(foreach dir,$(INCLUDES),-I$(dir)) \
                  $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                  -I$(BUILD)
export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)
export _3DSXDEPS := $(OUTPUT).smdh
export _3DSXFLAGS += --smdh=$(OUTPUT).smdh

.PHONY: all clean print-config port-smoke renderer-smoke controller-smoke window-smoke audio-smoke thread-smoke platform-smoke bind-smoke controls-smoke terminal-smoke shader-smoke

all: $(BUILD)
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(TOPDIR)/Makefile.new3ds TOPDIR=$(TOPDIR)
	@echo "Built $(OUTPUT).3dsx"

port-smoke: renderer-smoke controller-smoke window-smoke audio-smoke thread-smoke platform-smoke bind-smoke controls-smoke terminal-smoke shader-smoke
	@echo "New 3DS platform smoke compile passed"

renderer-smoke: $(BUILD)
	@echo "smoke: Citro3D rendering backend"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/gfx/gfx_citro3d_new3ds.c \
		-o $(BUILD)/gfx_citro3d_new3ds.smoke.o

controller-smoke: $(BUILD)
	@echo "smoke: native controller backend"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/controller/controller_new3ds.c \
		-o $(BUILD)/controller_new3ds.smoke.o

window-smoke: $(BUILD)
	@echo "smoke: native window/lifecycle + software keyboard backend"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/platform/new3ds/new3ds_window_manager.c \
		-o $(BUILD)/new3ds_window_manager.smoke.o

audio-smoke: $(BUILD)
	@echo "smoke: native NDSP audio backend"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/audio/audio_new3ds.c \
		-o $(BUILD)/audio_new3ds.smoke.o

thread-smoke: $(BUILD)
	@echo "smoke: libctru thread backend"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/platform/new3ds/new3ds_thread.c \
		-o $(BUILD)/new3ds_thread.smoke.o

platform-smoke: $(BUILD)
	@echo "smoke: native SD-card platform backend"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/platform/new3ds/new3ds_platform.c \
		-o $(BUILD)/new3ds_platform.smoke.o

bind-smoke: $(BUILD)
	@echo "smoke: SDL-free New 3DS bind-name mapping"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/platform/new3ds/new3ds_bind_mapping.c \
		-o $(BUILD)/new3ds_bind_mapping.smoke.o

controls-smoke: $(BUILD)
	@echo "smoke: handheld-first DJUI controls panel"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/platform/new3ds/new3ds_djui_controls.c \
		-o $(BUILD)/new3ds_djui_controls.smoke.o

terminal-smoke: $(BUILD)
	@echo "smoke: New 3DS terminal stub"
	@$(CC) $(SMOKE_CFLAGS) -c \
		$(TOPDIR)/src/pc/platform/new3ds/new3ds_terminal_stub.c \
		-o $(BUILD)/new3ds_terminal_stub.smoke.o

shader-smoke: $(BUILD)
	@echo "smoke: PICA200 vertex shader"
	@$(PICASSO) \
		-o $(BUILD)/new3ds_shader.shbin \
		$(TOPDIR)/src/pc/platform/new3ds/new3ds_shader.v.pica
	@test -s $(BUILD)/new3ds_shader.shbin

$(BUILD):
	@mkdir -p $@

clean:
	@echo "clean New 3DS build"
	@rm -rf $(BUILD)

print-config:
	@echo "DEVKITPRO=$(DEVKITPRO)"
	@echo "DEVKITARM=$(DEVKITARM)"
	@echo "CTRULIB=$(CTRULIB)"
	@echo "OUTPUT=$(OUTPUT).3dsx"
	@echo "SOURCES=$(SOURCES)"
	@echo "SHELL_CFILES=$(SHELL_CFILES)"
	@echo "PICASSO=$(PICASSO)"

else

$(OUTPUT).3dsx: $(OUTPUT).elf $(_3DSXDEPS)

$(OUTPUT).elf: $(OFILES)

-include $(DEPSDIR)/*.d

endif
# Nintendo Switch platform, lifecycle, and native-input probe.

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO, for example /opt/devkitpro")
endif

LIBNX      := $(DEVKITPRO)/libnx
DEVKITA64  := $(DEVKITPRO)/devkitA64
TOOLS      := $(DEVKITPRO)/tools/bin
CC         := $(DEVKITA64)/bin/aarch64-none-elf-gcc
ELF2NRO    := $(TOOLS)/elf2nro
NACPTOOL   := $(TOOLS)/nacptool

BUILD_DIR  := build/switch-platform
TARGET     := $(BUILD_DIR)/sm64coopdx-switch-platform
SOURCES    := tools/switch/platform_probe.c \
              src/pc/platform/switch/switch_platform.c \
              src/pc/platform/switch/switch_input.c \
              src/pc/controller/controller_switch.c
OBJECTS    := $(patsubst %.c,$(BUILD_DIR)/%.o,$(SOURCES))
ELF        := $(TARGET).elf
NACP       := $(TARGET).nacp
NRO        := $(TARGET).nro

ARCH       := -march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -fPIE
CFLAGS     := -std=gnu11 -O2 -g -Wall -Wextra -ffunction-sections -fdata-sections \
              $(ARCH) -D__SWITCH__ -DNON_MATCHING -DAVOID_UB -I$(LIBNX)/include -I. -Iinclude -Isrc -Ilib/src
LDFLAGS    := -specs=$(LIBNX)/switch.specs -g $(ARCH) -Wl,--gc-sections \
              -Wl,-Map,$(TARGET).map -L$(LIBNX)/lib
LIBS       := -lnx -lm

.PHONY: all probe toolchain-check clean

all: probe

probe: toolchain-check $(NRO)
	@echo "Built $(NRO)"

toolchain-check:
	@test -x "$(CC)" || (echo "Missing devkitA64 compiler: $(CC)" && exit 1)
	@test -f "$(LIBNX)/switch.specs" || (echo "Missing libnx switch.specs" && exit 1)
	@test -x "$(ELF2NRO)" || (echo "Missing elf2nro: $(ELF2NRO)" && exit 1)
	@test -x "$(NACPTOOL)" || (echo "Missing nacptool: $(NACPTOOL)" && exit 1)

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -MF $(@:.o=.d) -c $< -o $@

$(ELF): $(OBJECTS)
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) $(OBJECTS) $(LIBS) -o $@

$(NACP):
	@mkdir -p $(dir $@)
	$(NACPTOOL) --create "SM64CoopDX Platform Probe" "SM64CoopDX contributors" "0.0.2" $@

$(NRO): $(ELF) $(NACP)
	$(ELF2NRO) $(ELF) $@ --nacp=$(NACP)

clean:
	rm -rf $(BUILD_DIR)

-include $(OBJECTS:.o=.d)

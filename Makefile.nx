# Nintendo Switch build overlay.
# Keep the known-working sm64coopNX source enumeration in Makefile.nx.base,
# then layer current-dev integration and release tuning here.
include Makefile.nx.base

NX_LTO ?= 0
NX_DEBUG ?= 0

# Current upstream network.c remains authoritative. Rename its selector only
# for that object so network_ldn.c can provide the public wrapper that adds
# NS_LDN without carrying an old copy of network.c.
$(BUILD)/src/pc/network/network.o: CFLAGS += -Dnetwork_set_system=network_set_system_base

ifeq ($(NX_DEBUG),1)
  CFLAGS += -Og -g3
  CXXFLAGS += -Og -g3
else
  # Cortex-A57 is already selected by the base recipe. O3 is a release-only
  # override; -pipe improves build throughput without changing generated code.
  CFLAGS += -O3 -pipe
  CXXFLAGS += -O3 -pipe
  LDFLAGS += -Wl,--gc-sections -Wl,-O1
endif

ifeq ($(NX_LTO),1)
  CFLAGS += -flto
  CXXFLAGS += -flto
  LDFLAGS += -flto
endif

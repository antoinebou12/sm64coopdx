# Convenience packaging target for copying a locally built Switch release to SD.
# The baserom is copied only from the developer's local/private checkout and is
# never fetched, generated, or committed by this target.

include Makefile.switch-game

SWITCH_SDMC_LAYOUT := $(BUILD_DIR)/sdmc-layout
SWITCH_SDMC_APP_DIR := $(SWITCH_SDMC_LAYOUT)/switch/sm64coopdx
SWITCH_SDMC_DEBUG_DIR := $(SWITCH_SDMC_LAYOUT)/debug
SWITCH_LOCAL_BASEROM := baserom.$(VERSION).z64

.PHONY: switch-sdmc-layout

switch-sdmc-layout: switch-nro
	@rm -rf "$(SWITCH_SDMC_LAYOUT)"
	@mkdir -p "$(SWITCH_SDMC_APP_DIR)/logs" "$(SWITCH_SDMC_DEBUG_DIR)"
	@cp "$(SWITCH_NRO)" "$(SWITCH_SDMC_APP_DIR)/sm64coopdx.nro"
	@cp "$(BUILD_DIR)/sm64coopdx.map" "$(SWITCH_SDMC_DEBUG_DIR)/sm64coopdx.map"
	@if [ -f "$(SWITCH_LOCAL_BASEROM)" ]; then \
		cp "$(SWITCH_LOCAL_BASEROM)" "$(SWITCH_SDMC_APP_DIR)/baserom.$(VERSION).z64"; \
		echo "Copied local baserom into the SD layout. Do not upload or redistribute it."; \
	else \
		echo "No $(SWITCH_LOCAL_BASEROM) found; SD layout created without a ROM."; \
	fi
	@printf '%s\n' \
		'SM64CoopDX Switch SD layout' \
		'' \
		'Copy the contents of this sdmc-layout directory to the root of the Switch SD card.' \
		'The game writes startup diagnostics to /switch/sm64coopdx/logs/startup.log.' \
		'Fatal userland exceptions are written to /switch/sm64coopdx/logs/exception.log.' \
		'Use debug/sm64coopdx.map together with runtime_main and pc/lr from exception.log to symbolize a crash.' \
		'' \
		'baserom.us.z64 is copyrighted game data. Keep your local copy private and do not upload it.' \
		> "$(SWITCH_SDMC_LAYOUT)/README.txt"
	@echo "SD layout: $(SWITCH_SDMC_LAYOUT)"

# Convenience packaging target for copying a locally built Switch release to SD.
# The baserom is copied only from the developer's local/private checkout and is
# never fetched, generated, or committed by this target.

include Makefile.switch-game

# Keep the extra call-site instrumentation on the SD-layout debug package. The
# hardened ROM checker and ROM asset loader themselves now come from the normal
# Switch build graph in Makefile.switch-game.
override LDFLAGS += \
    -Wl,--wrap=main_rom_handler \
    -Wl,--wrap=rom_assets_load \
    -Wl,--wrap=mods_init \
    -Wl,--wrap=audio_init \
    -Wl,--wrap=sound_init \
    -Wl,--wrap=network_player_init \
    -Wl,--wrap=thread5_game_loop \
    -Wl,--wrap=djui_init \
    -Wl,--wrap=djui_unicode_init \
    -Wl,--wrap=djui_init_late

SWITCH_SDMC_LAYOUT := $(BUILD_DIR)/sdmc-layout
SWITCH_SDMC_APP_DIR := $(SWITCH_SDMC_LAYOUT)/switch/sm64coopdx
SWITCH_SDMC_DEBUG_DIR := $(SWITCH_SDMC_LAYOUT)/debug
SWITCH_TRANSFER_ROOT := $(BUILD_DIR)/easy-transfer
SWITCH_TRANSFER_APP_DIR := $(SWITCH_TRANSFER_ROOT)/switch/sm64coopdx
SWITCH_LOCAL_BASEROM := baserom.$(VERSION).z64
SWITCH_JUICE_PROBE_NRO := build/switch-juice-probe/sm64coopdx-switch-juice-probe.nro

.PHONY: switch-sdmc-layout switch-transfer-folder

switch-sdmc-layout: switch-nro
	@rm -rf "$(SWITCH_SDMC_LAYOUT)"
	@mkdir -p "$(SWITCH_SDMC_APP_DIR)/logs" "$(SWITCH_SDMC_DEBUG_DIR)"
	@cp "$(SWITCH_NRO)" "$(SWITCH_SDMC_APP_DIR)/sm64coopdx.nro"
	@cp "$(ELF)" "$(SWITCH_SDMC_DEBUG_DIR)/sm64coopdx.elf"
	@cp "$(BUILD_DIR)/sm64coopdx.map" "$(SWITCH_SDMC_DEBUG_DIR)/sm64coopdx.map"
	@if [ -f "$(SWITCH_JUICE_PROBE_NRO)" ]; then \
		cp "$(SWITCH_JUICE_PROBE_NRO)" "$(SWITCH_SDMC_DEBUG_DIR)/juice-probe.nro"; \
	fi
	@cp -r lang "$(SWITCH_SDMC_APP_DIR)/lang"
	@if [ -f "$(SWITCH_LOCAL_BASEROM)" ]; then \
		cp "$(SWITCH_LOCAL_BASEROM)" "$(SWITCH_SDMC_APP_DIR)/baserom.$(VERSION).z64"; \
		echo "Copied local baserom into the SD layout. Do not upload or redistribute it."; \
	else \
		echo "No $(SWITCH_LOCAL_BASEROM) found; SD layout created without a ROM."; \
	fi
	@printf '%s\n' \
		'SM64CoopDX Switch SD layout' \
		'' \
		'Copy the contents of this sdmc-layout directory to the root of the Switch SD card.' \
		'SWITCH_COOPNET=$(SWITCH_COOPNET)' \
		'The game writes startup diagnostics to /switch/sm64coopdx/logs/startup.log.' \
		'CoopNet diagnostics are written to /switch/sm64coopdx/logs/coopnet.log.' \
		'The last durable CoopNet library boundary is /switch/sm64coopdx/logs/coopnet_checkpoint.txt.' \
		'The exact ROM asset/segment in progress is /switch/sm64coopdx/logs/current_rom_asset.txt.' \
		'Fatal userland exceptions are written to /switch/sm64coopdx/logs/exception.log.' \
		'Use debug/sm64coopdx.elf and debug/sm64coopdx.map with runtime_main and pc/lr from exception.log to symbolize a crash.' \
		'If built separately, the standalone ICE probe is copied to debug/juice-probe.nro.' \
		'' \
		'Never share lobby passwords or TURN credentials in logs or bug reports.' \
		'baserom.us.z64 is copyrighted game data. Keep your local copy private and do not upload it.' \
		> "$(SWITCH_SDMC_LAYOUT)/README.txt"
	@echo "SD layout: $(SWITCH_SDMC_LAYOUT)"

# Minimal copy-ready tree for normal hardware testing. This intentionally omits
# debug ELF/map files so copying the folder to the SD root only installs the app.
switch-transfer-folder: switch-sdmc-layout
	@rm -rf "$(SWITCH_TRANSFER_ROOT)"
	@mkdir -p "$(SWITCH_TRANSFER_APP_DIR)"
	@cp -r "$(SWITCH_SDMC_APP_DIR)/." "$(SWITCH_TRANSFER_APP_DIR)/"
	@printf '%s\n' \
		'SM64CoopDX Switch - copy-ready folder' \
		'' \
		'Copy the contents of this easy-transfer directory to the root of the Switch SD card.' \
		'This installs /switch/sm64coopdx with the NRO, language files, logs directory, and local baserom when present.' \
		> "$(SWITCH_TRANSFER_ROOT)/README.txt"
	@echo "Copy-ready Switch folder: $(SWITCH_TRANSFER_ROOT)"

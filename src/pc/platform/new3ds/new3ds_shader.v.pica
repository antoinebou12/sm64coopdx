; SM64CoopDX New 3DS pass-through vertex shader
;
; v0 = clip-space position
; v1 = texture coordinate 0
; v2 = texture coordinate 1 / light-map coordinate
; v3 = primary combiner color
;
; uStereo = (shear, -shear * convergence, 0, 0)
;
; Stereoscopic parallax is a clip-space shear applied to the component that ends
; up horizontal on the physical screen. gfx_pc hands this backend clip-space
; vertices and new3ds_write_gpu_vertex() bakes the 90-degree screen rotation into
; them (dst[0] = src[1], dst[1] = -src[0]), so the horizontal axis here is y, not
; x. After the perspective divide the offset is shear * (1 - convergence/w):
; zero parallax at the convergence plane, approaching shear at infinity.
;
; With uStereo = (0, 0, 0, 0) the added term is exactly zero, so the monoscopic
; path produces bit-identical positions.

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias intex0 v1
.alias intex1 v2
.alias inclr v3

.fvec uStereo

.proc main
    mov r0, inpos
    mul r1, uStereo.xxxx, inpos.wwww
    ; PICA only accepts a uniform as source1, so the uniform leads here.
    add r1, uStereo.yyyy, r1
    add r0.y, r0, r1
    mov outpos, r0
    mov outtc0, intex0
    mov outtc1, intex1
    mov outclr, inclr
    end
.end
